# Groq LLM Credentials
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/querynest

# JWT Authentication
JWT_SECRET_KEY=replace_this_with_a_long_random_secret_key_32_bytes_or_more
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60